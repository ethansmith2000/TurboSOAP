@@ -1,6 +1,46 @@
 \hypertarget{method}{%
 \section{3. Method}\label{method}}
 
+Algorithm~1 summarizes one call for a single matrix parameter;
+Sections 3.1--3.4 specify its precision, ordering, and execution.
+
+\begin{algorithm}[H]
+\caption{One TurboSOAP call for \(W\in\mathbb{R}^{m\times n}\) at matrix
+age \(t\ge1\) (warm10/QR50). Precision boundaries are omitted; see
+Section 3.1.}
+\begin{algorithmic}[1]
+\State \(\bar G\gets Q_L^\top G\,Q_R\) \Comment{\(G\): clipped gradient}
+\State \(M_f\gets\beta_1M+(1-\beta_1)\bar G,\quad
+ V_f\gets\beta_2V+(1-\beta_2)\bar G^{2}\)
+\State \(W\gets\bigl(W-\eta_k c_t\,Q_L\,\tfrac{M_f}{\sqrt{V_f}+\epsilon}\,Q_R^\top\bigr)(1-\eta_k\lambda)\)
+ \Comment{\(c_t=\sqrt{1-\beta_2^t}/(1-\beta_1^t)\)}
+\State \(M,V\gets M_f,V_f\);\quad
+ \(C_L\gets\beta_CC_L+(1-\beta_C)GG^\top,\ C_R\gets\beta_CC_R+(1-\beta_C)G^\top G\)
+\If{\(t\bmod 50=0\)} \Comment{QR repair: FP32 island}
+ \State \((Q_L^+,\pi_L)\gets\textsc{QRRepair}(C_L,Q_L)\);\ \((Q_R^+,\pi_R)\gets\textsc{QRRepair}(C_R,Q_R)\)
+ \State permute rows of \(V\) by \(\pi_L\) and columns by \(\pi_R\)
+\ElsIf{\(t\bmod 10=0\)} \Comment{warm refresh: matrix products only}
+ \State \(Q_L^+\gets\textsc{WarmRefresh}(C_L,Q_L)\);\ \(Q_R^+\gets\textsc{WarmRefresh}(C_R,Q_R)\)
+\Else
+ \State \Return
+\EndIf
+\State \(M\gets (Q_L^+)^\top\bigl(Q_LMQ_R^\top\bigr)Q_R^+\);\quad \(Q_L,Q_R\gets Q_L^+,Q_R^+\)
+\Statex
+\Function{WarmRefresh}{$C,Q$}
+ \State \(B\gets\operatorname{sym}(Q^\top CQ)\),\ \(d\gets\operatorname{diag}B\),\ \(s\gets\max_i|d_i|\),\ \(h_{ij}\gets(d_i-d_j)/s\)
+ \State \(A_{ij}\gets-\tfrac12\,(B_{ij}/s)\,h_{ij}/(h_{ij}^2+0.01^2)\);\quad
+ \(A\gets\min\bigl(1,\,0.5\sqrt2/\|A\|_F\bigr)A\)
+ \State \(Y\gets Q+QA\)
+ \For{\(j=1,2\)} \(Y\gets Y-\tfrac12Y(Y^\top Y-I)\) \EndFor
+ \State \Return \(Y\)
+\EndFunction
+\Function{QRRepair}{$C,Q$}
+ \State \(Z\gets CQ\);\ \(\pi\gets\operatorname{argsort}_{\downarrow}\operatorname{diag}(Q^\top Z)\)
+ \State \Return \((\operatorname{qr}(Z_{:,\pi}).Q,\ \pi)\)
+\EndFunction
+\end{algorithmic}
+\end{algorithm}
+
