{
  "dataset": "hf",
  "dataset_name": "Salesforce/wikitext",
  "dataset_config": "wikitext-2-raw-v1",
  "tokenizer_name": "gpt2",
  "max_train_documents": 2000,
  "max_validation_documents": 500,
  "dim": 128,
  "depth": 4,
  "heads": 4,
  "ff_multiplier": 2.6666666666666665,
  "sequence_length": 128,
  "qk_norm": true,
  "norm_eps": 1e-5,
  "tie_embeddings": true,
  "input_projection": false,
  "optimizer": "soap",
  "learning_rate": 0.0025,
  "soap_fallback_lr": 0.0003,
  "beta1": 0.95,
  "beta2": 0.99,
  "soap_shampoo_beta": 0.999,
  "soap_precondition_frequency": 10,
  "soap_precondition_mode": "all",
  "soap_normalize_grads": true,
  "soap_reset_frequency": 20,
  "batch_size": 8,
  "gradient_accumulation_steps": 1,
  "steps": 200,
  "warmup_steps": 20,
  "scheduler": "cosine",
  "min_lr_ratio": 0.1,
  "eval_every": 50,
  "eval_batches": 20,
  "log_every": 20,
  "timing_warmup": 20,
  "seed": 123,
  "dtype": "bfloat16",
  "compile": false
}
